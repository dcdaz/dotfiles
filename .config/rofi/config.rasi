configuration {
    modi:               "drun";
    location:           0;
    yoffset:            -200;
    fixed-num-lines:    true;
    font:               "Inconsolata Nerd Font Mono Medium 11";
    show-icons:         true;
    icon-theme:         "Papirus";
    me-select-entry: "MousePrimary";
    me-accept-entry: "!MousePrimary";
}

@theme "arc_zero"
